rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Donor photo uploads from the public booking form.
    // Anonymous uploads allowed but capped at 5MB and images only.
    // Reads are admin-only (donor photos are PII-adjacent).
    //
    // Note: we guard against a null contentType before calling .matches(),
    // because mobile browsers occasionally omit it and an unguarded match
    // on null denies the whole upload. Size cap still applies.
    match /bookings/{fileName} {
      allow read: if request.auth != null;
      allow create: if
        request.resource.size < 5 * 1024 * 1024 &&
        (
          request.resource.contentType == null ||
          request.resource.contentType.matches('image/.*')
        );
      allow update, delete: if request.auth != null;
    }

    // Everything else admin-only.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
